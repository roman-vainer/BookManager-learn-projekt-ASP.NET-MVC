@model IEnumerable<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="container my-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1 class="mb-0">Book Overview</h1>
		<div>
			<a asp-action="Create" class="btn btn-primary">Add Book</a>
		</div>
	</div>

	@if (!Model.Any())
	{
		<div class="alert alert-info">No books yet. Use "Add Book" to create the first one.</div>
	}
	else
	{
		<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
			@foreach (var book in Model)
			{
				<div class="col">
					<div class="card h-100 shadow-sm">
						<div class="card-body">
							<h5 class="card-title">@book.Title</h5>
							<h6 class="card-subtitle mb-2 text-body-secondary">@book.Author</h6>
							<p class="card-text mb-1"><span class="text-body-secondary">Genre:</span> @(string.IsNullOrWhiteSpace(book.Genre) ? "Not specified" : book.Genre)</p>
							<p class="card-text mb-2"><span class="text-body-secondary">Published:</span> @(book.YearPublished?.ToString() ?? "Unknown")</p>
							@if (book.IsAvailable)
							{
								<span class="badge availability-available">Available</span>
							}
							else
							{
								<span class="badge availability-unavailable">Not available</span>
							}
						</div>
						<div class="card-footer bg-transparent d-flex gap-2">
							<a asp-action="Detail" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">Details</a>
							<a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
							<a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger">Delete</a>
						</div>
					</div>
				</div>
			}
		</div>
	}
</div>
