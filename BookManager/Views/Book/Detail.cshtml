@model Book
@{
	ViewData["Title"] = "Book Details";
}

<div class="container my-4">
	<div class="card shadow-sm">
		<div class="row g-0">
			<div class="col-md-4 bg-body-tertiary d-flex align-items-center justify-content-center p-3">
				@if (!string.IsNullOrWhiteSpace(Model.ImagePath))
				{
					<div class="w-100 text-center">
						<img src="@Model.ImagePath" class="img-fluid rounded" style="max-height: 28rem; object-fit: contain;" alt="Cover of @Model.Title" onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');" />
						<span class="text-body-secondary d-none">Cover image not found</span>
					</div>
				}
				else
				{
					<span class="text-body-secondary">No cover available</span>
				}
			</div>
			<div class="col-md-8">
				<div class="card-body">
					<h1 class="card-title h3">@Model.Title</h1>
					<dl class="row mb-3">
						<dt class="col-sm-4">Author</dt>
						<dd class="col-sm-8">@Model.Author</dd>
						<dt class="col-sm-4">Genre</dt>
						<dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Genre) ? "Not specified" : Model.Genre)</dd>
						<dt class="col-sm-4">Year published</dt>
						<dd class="col-sm-8">@(Model.YearPublished?.ToString() ?? "Unknown")</dd>
						<dt class="col-sm-4">Number of pages</dt>
						<dd class="col-sm-8">@Model.NumberOfPages</dd>
						<dt class="col-sm-4">Availability</dt>
						<dd class="col-sm-8">
							@if (Model.IsAvailable)
							{
								<span class="badge availability-available">Available</span>
							}
							else
							{
								<span class="badge availability-unavailable">Not available</span>
							}
						</dd>
						<dt class="col-sm-4">Description</dt>
						<dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description." : Model.Description)</dd>
					</dl>
					<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
					<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
					<a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
				</div>
			</div>
		</div>
	</div>
</div>
