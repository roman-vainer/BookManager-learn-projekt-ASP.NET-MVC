@{
    ViewData["Title"] = "Home";
}

<div class="row justify-content-center py-md-4">
    <div class="col-lg-8">
        <div class="home-panel rounded-4 shadow-sm p-4 p-md-5">
            <p class="text-uppercase small fw-semibold app-kicker mb-2">ASP.NET MVC Learning Project</p>
            <h1 class="display-6 fw-semibold mb-3">Welcome to It-Book-Manager</h1>
            <p class="lead mb-4">
                Manage your technical and learning books with full Create, Read, Update and Delete workflows.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" asp-controller="Book" asp-action="Index">View Books</a>
                <a class="btn btn-outline-secondary" asp-controller="Book" asp-action="Create">Create New Book</a>
            </div>
        </div>
    </div>
</div>
